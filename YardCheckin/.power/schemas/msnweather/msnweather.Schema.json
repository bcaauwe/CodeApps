        "/{connectionId}/current/{Location}": {
          "get": {
            "summary": "Get current weather",
            "description": "Get the current weather for a location.",
            "x-ms-name-for-model": "current_weather",
            "x-ms-description-for-model": "Use this tool to get the current weather, temperature, or conditions at a geographic location or landmark. Always include the 'units' parameter — never ask the user which units they prefer. Default to 'I' (Imperial) for US locations, 'C' (Metric) for all others. Example requests include \"What's the weather in Seattle?\", or \"Is it raining in 98052?\".",
            "operationId": "CurrentWeather",
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "$ref": "#/parameters/Location"
              },
              {
                "$ref": "#/parameters/Units"
              }
            ],
            "responses": {
              "200": {
                "description": "OK",
                "schema": {
                  "$ref": "#/definitions/CurrentWeather"
                }
              }
            },
            "deprecated": false,
            "x-ms-visibility": "advanced",
            "x-ms-openai-data": {
              "openai-enabled": true
            },
            "externalDocs": {
              "url": "https://docs.microsoft.com/connectors/msnweather/#get-current-weather"
            }
          }
        },
        "/{connectionId}/trigger/current/weather/{Location}": {
          "get": {
            "summary": "When the current weather changes",
            "description": "Triggers a new flow when the specified weather measure changes for a location.",
            "operationId": "OnCurrentWeatherChange",
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "$ref": "#/parameters/Location"
              },
              {
                "$ref": "#/parameters/Measure"
              },
              {
                "name": "When",
                "in": "query",
                "required": true,
                "description": "The condition the trigger will be checking. Valid options are 'Is equal to', 'Goes over', or 'Goes below'. For example, if the measure is 'temperature' and this parameter is set to 'Goes below' then the trigger will fire when the temperature goes below the target value.",
                "x-ms-summary": "When the measure...",
                "type": "string",
                "default": "Is equal to",
                "enum": [
                  "Is equal to",
                  "Goes over",
                  "Goes below"
                ],
                "x-ms-enum-values": [
                  {
                    "value": "Is equal to",
                    "displayName": "Is equal to"
                  },
                  {
                    "value": "Goes over",
                    "displayName": "Goes over"
                  },
                  {
                    "value": "Goes below",
                    "displayName": "Goes below"
                  }
                ]
              },
              {
                "name": "Target",
                "in": "query",
                "required": true,
                "description": "The target value for the specified measure.",
                "x-ms-summary": "Target",
                "type": "number",
                "format": "float",
                "x-ms-test-value": 0
              },
              {
                "name": "units",
                "in": "query",
                "required": true,
                "type": "string",
                "description": "The units for the measure value and the target value.",
                "x-ms-summary": "Units",
                "x-ms-dynamic-values": {
                  "operationId": "GetMeasureUnits",
                  "parameters": {
                    "Location": {
                      "parameter": "Location"
                    },
                    "Measure": {
                      "parameter": "Measure"
                    }
                  },
                  "value-path": "units",
                  "value-title": "displayText"
                },
                "x-ms-test-value": "Metric"
              }
            ],
            "responses": {
              "200": {
