        "/{connectionId}/forecast/today/{Location}": {
          "get": {
            "summary": "Get forecast for today",
            "description": "Get the forecast for the current day in the specified location.",
            "x-ms-name-for-model": "todays_forecast",
            "x-ms-description-for-model": "Use this tool to fetch today's forecast and expected conditions for a location. Use when the user asks about conditions 'today', 'tonight', 'this afternoon', 'this evening', or 'later today', not just for current weather conditions. Always include the 'units' parameter — never ask the user which units they prefer. Default to 'I' (Imperial) for US locations, 'C' (Metric) for all others. Sample user intents: \"What's the forecast for today in Seattle?\", \"How's it looking this afternoon or tonight in San Fran?\".",
            "operationId": "TodaysForecast",
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
