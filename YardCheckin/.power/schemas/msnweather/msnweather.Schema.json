                "description": "OK",
                "schema": {
                  "$ref": "#/definitions/WeatherForecast"
                }
              }
            },
            "deprecated": false,
            "x-ms-visibility": "important",
            "x-ms-openai-data": {
              "openai-enabled": true
            },
            "externalDocs": {
              "url": "https://docs.microsoft.com/connectors/msnweather/#get-forecast-for-today"
            }
          }
        },
